# Supabase → project → Settings → Database
# use Transaction mode (port 6543) — required for Vercel serverless
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# used by seed scripts only — direct connection (port 5432)
DATABASE_URL_DIRECT=postgresql://postgres.[ref]:[password]@aws-0-[region].supabase.com:5432/postgres
